# OpenWeatherMap API Key (Server-side key, kept secure on backend)
# Get your free key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Server Port for local standalone development
PORT=5000

# Optional: Frontend API URL (leave empty when deploying full-stack on Vercel)
VITE_API_BASE_URL=
